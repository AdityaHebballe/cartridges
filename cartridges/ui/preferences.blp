using Gtk 4.0;
using Adw 1;

template $Preferences: Adw.PreferencesDialog {
  title: _("Preferences");
  search-enabled: true;

  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Behavior");

      Adw.SwitchRow exit_after_launch_switch {
        title: _("Close on Launch");
        subtitle: _("Close Cartridges after opening a game");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Sources");
    icon-name: "system-run-symbolic";

    Adw.PreferencesGroup {
      title: _("Enabled Sources");
      description: _("Choose which sources to import games from.");

      Adw.SwitchRow steam_switch {
        title: _("Steam");
        subtitle: _("Import games from Steam");

        [prefix]
        Image {
          icon-name: "steam-symbolic";
        }
      }

      Adw.SwitchRow faugus_switch {
        title: _("Faugus");
        subtitle: _("Import games from Faugus Launcher");

        [prefix]
        Image {
          icon-name: "faugus-symbolic";
        }
      }

      Adw.SwitchRow lutris_switch {
        title: _("Lutris");
        subtitle: _("Import games from Lutris");

        [prefix]
        Image {
          icon-name: "lutris-symbolic";
        }
      }

      Adw.SwitchRow heroic_switch {
        title: _("Heroic");
        subtitle: _("Import games from Heroic Games Launcher");

        [prefix]
        Image {
          icon-name: "heroic-symbolic";
        }
      }

      Adw.SwitchRow desktop_switch {
        title: _("Desktop");
        subtitle: _("Import games from desktop applications");

        [prefix]
        Image {
          icon-name: "desktop-symbolic";
        }
      }

      Adw.SwitchRow itch_switch {
        title: _("Itch");
        subtitle: _("Import games from itch.io");

        [prefix]
        Image {
          icon-name: "itch-symbolic";
        }
      }

      Adw.SwitchRow legendary_switch {
        title: _("Legendary");
        subtitle: _("Import games from Legendary CLI");

        [prefix]
        Image {
          icon-name: "legendary-symbolic";
        }
      }
    }
  }

  Adw.PreferencesPage {
    title: _("SteamGridDB");
    icon-name: "image-x-generic-symbolic";

    Adw.PreferencesGroup {
      title: _("Authentication");
      description: _("An API key is required to download covers from SteamGridDB.");

      Adw.PasswordEntryRow key_entry {
        title: _("API Key");
        show-apply-button: true;
        apply => $_key_applied();
        notify::text => $_key_applied();
      }

      Adw.ActionRow {
        title: _("Get API Key");
        subtitle: "steamgriddb.com/profile/preferences/api";
        activatable: true;
        activated => $_open_api_key_page();

        [suffix]
        Image {
          icon-name: "external-link-symbolic";
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Behavior");

      Adw.SwitchRow sgdb_switch {
        title: _("Use SteamGridDB");
        subtitle: _("Download covers from SteamGridDB");
      }

      Adw.SwitchRow sgdb_prefer_switch {
        title: _("Prefer Over Official Images");
        subtitle: _("Use SteamGridDB even when the game provides its own cover");
        sensitive: bind sgdb_switch.active;
      }

      Adw.SwitchRow sgdb_animated_switch {
        title: _("Prefer Animated Covers");
        subtitle: _("Download animated covers when available");
        sensitive: bind sgdb_switch.active;
      }
    }

    Adw.PreferencesGroup {
      title: _("Library Covers");

      Adw.ActionRow update_row {
        title: _("Download All Covers");
        subtitle: _("Fetch artwork from SteamGridDB for all games");
        sensitive: bind sgdb_switch.active;

        [suffix]
        Button update_button {
          label: _("Download");
          valign: center;
          clicked => $_update_covers();
        }

        [suffix]
        Adw.Spinner spinner {
          visible: false;
          valign: center;
        }
      }
    }
  }
}
